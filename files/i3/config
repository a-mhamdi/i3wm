# i3 configuration file

# Set mod key (Mod1 = Alt, Mod4 = Super/Windows key)
set $mod Mod4

# Font for window titles and bar (if using i3bar)
font pango:FiraCode Nerd Font 10

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# Define colors
set $bg-color            #2f343f
set $inactive-bg-color   #2f343f
set $text-color          #f3f4f5
set $inactive-text-color #676E7D
set $urgent-bg-color     #E53935
set $border-color        #4a5160
set $indicator-color     #00ff00

# Window colors
client.focused          $border-color       $bg-color          $text-color          $indicator-color
client.unfocused        $inactive-bg-color  $inactive-bg-color $inactive-text-color $indicator-color
client.focused_inactive $inactive-bg-color  $inactive-bg-color $inactive-text-color $indicator-color
client.urgent           $urgent-bg-color    $urgent-bg-color   $text-color          $indicator-color

# Window appearance
default_border pixel 4
default_floating_border pixel 2
hide_edge_borders smart
focus_follows_mouse yes

# Gaps configuration
gaps inner 4
gaps outer 4
# smart_gaps on

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"

workspace $ws1 output eDP-1 HDMI-1
workspace $ws2 output eDP-1 HDMI-1
workspace $ws3 output eDP-1 HDMI-1
workspace $ws4 output eDP-1 HDMI-1
workspace $ws5 output eDP-1 HDMI-1
workspace $ws6 output eDP-1 HDMI-1
workspace $ws7 output eDP-1 HDMI-1
workspace $ws8 output eDP-1 HDMI-1
workspace $ws9 output eDP-1 HDMI-1
workspace $ws10 output eDP-1 HDMI-1
workspace $ws11 output HDMI-1 eDP-1

# Essential keybindings (keeping minimal set, let sxhkd handle most)
bindsym $mod+Return exec kitty
bindsym $mod+q kill
bindsym $mod+space exec rofi -show drun -theme ~/.config/rofi/config.rasi

# Basic window management
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split in horizontal/vertical orientation
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+e layout toggle split

# Enter fullscreen mode
bindsym $mod+f fullscreen toggle

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Focus parent/child container
bindsym $mod+a focus parent
bindsym $mod+c focus child

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+m workspace $ws11

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10
bindsym $mod+Shift+Right move container to workspace next_on_output; workspace next_on_output
bindsym $mod+Shift+Left move container to workspace prev_on_output;

# Move to monitor
bindsym $mod+Shift+m move container to output next
# bindsym $mod+Shift+{greater,less} move workspace to output next

# Reload/restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Resize mode
mode "Resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "Resize"

# Application-specific window rules
# `xprop | grep WM_CLASS`
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="MEGAsync"] move to workspace $ws1
for_window [class="Brave-browser"] move to workspace $ws2

# Workspace assignments
# assign [class="MEGAsync"] $ws1

# Autostart applications
exec_always --no-startup-id feh --bg-scale  ~/Pictures/wallpaper.jpg
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b

exec --no-startup-id sxhkd -c ~/.config/sxhkd/sxhkdrc
exec --no-startup-id xdotool key --clearmodifiers Num_Lock
exec --no-startup-id megasync
